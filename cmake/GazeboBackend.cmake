include_guard(GLOBAL)

function(real_gps_validate_backend)
  set(GZ_DISTRO harmonic CACHE STRING "Gazebo backend: harmonic or jetty")
  set_property(CACHE GZ_DISTRO PROPERTY STRINGS harmonic jetty)
  if(NOT GZ_DISTRO MATCHES "^(harmonic|jetty)$")
    message(FATAL_ERROR "Unknown GZ_DISTRO='${GZ_DISTRO}'; choose harmonic or jetty")
  endif()
  if(DEFINED REAL_GPS_CONFIGURED_DISTRO AND NOT REAL_GPS_CONFIGURED_DISTRO STREQUAL GZ_DISTRO)
    message(FATAL_ERROR "Use separate build directories for Harmonic and Jetty; this cache is ${REAL_GPS_CONFIGURED_DISTRO}")
  endif()
  set(REAL_GPS_CONFIGURED_DISTRO ${GZ_DISTRO} CACHE INTERNAL "Original Gazebo ABI")
endfunction()

function(real_gps_require_major package expected)
  if(NOT "${${package}_VERSION}" MATCHES "^${expected}([.]|$)")
    message(FATAL_ERROR "${package} must be major ${expected}, found ${${package}_VERSION}")
  endif()
endfunction()

function(real_gps_resolve_target output)
  foreach(candidate IN LISTS ARGN)
    if(TARGET ${candidate})
      set(${output} ${candidate} PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "No supported target exported: ${ARGN}")
endfunction()

function(real_gps_configure_backend target)
  if(GZ_DISTRO STREQUAL harmonic)
    find_package(gz-sim8 8 REQUIRED CONFIG)
    find_package(gz-plugin2 2 REQUIRED CONFIG COMPONENTS register)
    find_package(gz-transport13 13 REQUIRED CONFIG)
    real_gps_require_major(gz-sim8 8)
    real_gps_require_major(gz-plugin2 2)
    real_gps_require_major(gz-transport13 13)
    target_link_libraries(${target} PRIVATE gz-sim8::gz-sim8 gz-plugin2::register gz-transport13::gz-transport13)
  else()
    find_package(gz-sim 10 REQUIRED CONFIG NAMES gz-sim gz-sim10)
    find_package(gz-plugin 4 REQUIRED CONFIG NAMES gz-plugin gz-plugin4 COMPONENTS register)
    find_package(gz-transport 15 REQUIRED CONFIG NAMES gz-transport gz-transport15)
    real_gps_require_major(gz-sim 10)
    real_gps_require_major(gz-plugin 4)
    real_gps_require_major(gz-transport 15)
    real_gps_resolve_target(sim_target gz-sim::gz-sim gz-sim10::gz-sim10)
    real_gps_resolve_target(plugin_target gz-plugin::register gz-plugin::gz-plugin-register
      gz-plugin4::register gz-plugin4::gz-plugin4-register)
    real_gps_resolve_target(transport_target gz-transport::gz-transport gz-transport15::gz-transport15)
    target_link_libraries(${target} PRIVATE ${sim_target} ${plugin_target} ${transport_target})
  endif()
endfunction()
